{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://local.invalid/auto-rok/mission-plan.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","mission_id","timezone","due_local","max_attempts","retry_backoff_seconds","steps"],
  "properties":{
    "schema_version":{"const":1},"mission_id":{"type":"string","minLength":1},
    "timezone":{"type":"string","pattern":"^[+-][0-9]{2}:[0-9]{2}$"},
    "due_local":{"type":"string","pattern":"^[0-2][0-9]:[0-5][0-9]$"},
    "max_attempts":{"type":"integer","minimum":1,"maximum":3},
    "retry_backoff_seconds":{"type":"array","minItems":1,"items":{"type":"integer","minimum":1,"maximum":86400}},
    "steps":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,
      "required":["id","target_id","proposal","preconditions","postconditions"],
      "properties":{"id":{"type":"string","minLength":1},"target_id":{"type":"string","minLength":1},"proposal":{"type":"object"},"preconditions":{"type":"array","items":{"type":"string"}},"postconditions":{"type":"array","items":{"type":"string"}}}}}
  }
}
